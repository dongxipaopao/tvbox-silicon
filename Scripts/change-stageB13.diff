diff --git a/App/DiscoverView.swift b/App/DiscoverView.swift
index 54e65e8..fcf1020 100644
--- a/App/DiscoverView.swift
+++ b/App/DiscoverView.swift
@@ -100,6 +100,8 @@ struct DiscoverView: View {
     @FocusState private var tvFocus: DiscoverTVFocus?
     #endif
     @AppStorage("discover.hiddenSections") private var hiddenSections = ""
+    /// Comma-separated section ids in the viewer's order (Edit Layout, drag to reorder). Featured Titles stays first.
+    @AppStorage("discover.sectionOrder") private var sectionOrder = ""
     /// Douban's lists are in Chinese: shown by default only when the app is.
     @AppStorage("discover.doubanShown") private var doubanShown = TMDBMatch.language.hasPrefix("zh")
     /// IMDb's and Douban's charts of the day (#631), or this week's TMDB trending titles when those didn't load.
@@ -129,7 +131,7 @@ struct DiscoverView: View {
                         if waiting {
                             ProgressView().frame(maxWidth: .infinity).frame(height: heroShown ? min(proxy.size.width * 1.5, 660) : 160)
                         }
-                        ForEach(DiscoverSection.allCases.filter(visible)) { section in
+                        ForEach(orderedSections.filter(visible)) { section in
                             sectionView(section, width: proxy.size.width)
                         }
                         if !model.failures.isEmpty || model.collectionsFailed {
@@ -265,19 +267,40 @@ struct DiscoverView: View {
         .sheet(isPresented: $editing) {
             NavigationStack {
                 Form {
-                    ForEach(DiscoverSection.allCases) { section in
+                    ForEach(orderedSections) { section in
                         Toggle(section.title, isOn: shown(section))
                             #if !os(tvOS)
                             .settingsSwitch()
                             #endif
+                            .moveDisabled(section == .hero)
                     }
+                    .onMove(perform: moveSections)
                 }
+                #if os(iOS)
+                .environment(\.editMode, .constant(.active))
+                #endif
                 .navigationTitle(L10n.text("Edit Layout"))
                 .toolbar { ToolbarItem(placement: .confirmationAction) { Button(L10n.text("Done")) { editing = false } } }
             }.preferredColorScheme(.dark).discoverSheetSize(width: 420, height: 560)
         }
     }
 
+    /// The sections in the viewer's saved order: Featured Titles first, then the saved ids, then any the order doesn't know yet.
+    private var orderedSections: [DiscoverSection] {
+        let saved = sectionOrder.split(separator: ",").compactMap { DiscoverSection(rawValue: String($0)) }.filter { $0 != .hero }
+        var seen = Set<DiscoverSection>()
+        let rest = (saved + DiscoverSection.allCases.filter { $0 != .hero }).filter { seen.insert($0).inserted }
+        return [.hero] + rest
+    }
+
+    private func moveSections(from source: IndexSet, to destination: Int) {
+        var list = orderedSections
+        list.move(fromOffsets: source, toOffset: destination)
+        // Featured Titles is pinned first, whatever was dragged past it.
+        list.removeAll { $0 == .hero }
+        sectionOrder = list.map(\.rawValue).joined(separator: ",")
+    }
+
     private func visible(_ section: DiscoverSection) -> Bool {
         section == .douban ? doubanShown : !hiddenSections.split(separator: ",").contains(Substring(section.rawValue))
     }
