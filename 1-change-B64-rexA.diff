diff --git a/App/RexView.swift b/App/RexView.swift
new file mode 100644
index 00000000..dd211718
--- /dev/null
+++ b/App/RexView.swift
@@ -0,0 +1,281 @@
+#if !os(tvOS)
+import SwiftUI
+import TVCore
+
+/// What the person has imported from Rex subscriptions, and what each module can open.
+@MainActor @Observable final class RexModel {
+    static let shared = RexModel()
+    struct Entry: Identifiable {
+        let widget: RexCollection.Widget
+        var problem: RexError?
+        var checked = false
+        var id: String { widget.url }
+    }
+    struct Imported: Identifiable { let address: String; let collection: RexCollection; var id: String { address } }
+    private(set) var collections: [Imported] = []
+    private(set) var entries: [Entry] = []
+    var message: String?
+    var busy = false
+    private var started = false
+
+    func start() async {
+        guard !started else { return }
+        started = true
+        #if DEBUG
+        if UserDefaults.standard.bool(forKey: "qaRexFixture") { await add("assets://rex/fixture.json"); return }
+        if let address = UserDefaults.standard.string(forKey: "qaRexCollection") { await add(address); return }
+        #endif
+        for address in RexStore.addresses { await load(address, remember: false) }
+    }
+
+    func add(_ address: String) async {
+        let trimmed = address.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty else { return }
+        await load(trimmed, remember: !trimmed.hasPrefix("assets://"))
+    }
+
+    func remove(_ address: String) {
+        RexStore.addresses.removeAll { $0 == address }
+        collections.removeAll { $0.address == address }
+        rebuild()
+    }
+
+    private func load(_ address: String, remember: Bool) async {
+        busy = true; message = nil
+        defer { busy = false }
+        do {
+            let collection = try await RexRuntime.fetchCollection(address)
+            guard !collection.widgets.isEmpty else { message = L10n.text("This subscription has no modules."); return }
+            collections.removeAll { $0.address == address }
+            collections.append(Imported(address: address, collection: collection))
+            if remember, !RexStore.addresses.contains(address) { RexStore.addresses.append(address) }
+            rebuild()
+            await check(collection.widgets)
+        } catch {
+            message = (error as? LocalizedError)?.errorDescription ?? error.localizedDescription
+        }
+    }
+
+    private func rebuild() {
+        let old = Dictionary(uniqueKeysWithValues: entries.map { ($0.id, $0) })
+        entries = collections.flatMap(\.collection.widgets).map { old[$0.url] ?? Entry(widget: $0) }
+    }
+
+    /// Opens each module once, four at a time, to tell the ones that run from the encrypted or broken ones.
+    private func check(_ widgets: [RexCollection.Widget]) async {
+        var start = 0
+        while start < widgets.count {
+            let batch = Array(widgets[start..<min(start + 4, widgets.count)])
+            start += 4
+            let results = await withTaskGroup(of: (String, RexError?).self) { group -> [(String, RexError?)] in
+                for widget in batch { group.addTask { (widget.url, await RexRuntime.shared.probe(widget)) } }
+                var all: [(String, RexError?)] = []
+                for await result in group { all.append(result) }
+                return all
+            }
+            for (url, problem) in results {
+                if let index = entries.firstIndex(where: { $0.id == url }) { entries[index].problem = problem; entries[index].checked = true }
+            }
+        }
+    }
+}
+
+/// Discover's Rex row: the modules that run, with an import button for a subscription address.
+struct RexShelf: View {
+    @State private var model = RexModel.shared
+    @State private var importing = false
+    @State private var address = ""
+    #if DEBUG
+    @State private var qaOpen: RexCollection.Widget?
+    #endif
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            HStack {
+                Text(L10n.text("Rex Modules")).font(.system(size: DiscoverLayout.heading, weight: .semibold))
+                Spacer()
+                if model.busy { ProgressView() }
+                Button { importing = true } label: { Image(systemName: "plus.circle") }
+                    .buttonStyle(.plain).accessibilityIdentifier("rex.import").accessibilityLabel(L10n.text("Import Rex Subscription"))
+            }
+            .frame(height: DiscoverLayout.headingHeight, alignment: .top).padding(.horizontal, DiscoverLayout.gutter)
+            if model.entries.isEmpty {
+                Text(model.message ?? L10n.text("Import a Rex subscription to browse its list modules here."))
+                    .font(.footnote).foregroundStyle(.secondary).padding(.horizontal, DiscoverLayout.gutter)
+            } else {
+                ScrollView(.horizontal, showsIndicators: false) {
+                    LazyHStack(spacing: 12) {
+                        ForEach(model.entries) { entry in card(entry) }
+                    }.padding(.horizontal, DiscoverLayout.gutter)
+                }
+                if let message = model.message { Text(message).font(.footnote).foregroundStyle(.secondary).padding(.horizontal, DiscoverLayout.gutter).padding(.top, 6) }
+            }
+        }
+        .task {
+            await model.start()
+            #if DEBUG
+            // `-qaRexOpen 1` opens the first module that runs, for screenshots.
+            if UserDefaults.standard.bool(forKey: "qaRexOpen") {
+                for _ in 0..<40 where !model.entries.contains(where: { $0.checked && $0.problem == nil }) { try? await Task.sleep(for: .milliseconds(500)) }
+                qaOpen = model.entries.first { $0.checked && $0.problem == nil }?.widget
+            }
+            #endif
+        }
+        .sheet(isPresented: $importing) { importSheet }
+        #if DEBUG
+        .sheet(item: $qaOpen) { widget in NavigationStack { RexModuleView(widget: widget) } }
+        #endif
+    }
+
+    @ViewBuilder private func card(_ entry: RexModel.Entry) -> some View {
+        let supported = entry.checked && entry.problem == nil
+        let content = VStack(alignment: .leading, spacing: 4) {
+            Text(entry.widget.title).font(.subheadline.weight(.semibold)).lineLimit(2)
+            Text(status(entry)).font(.caption).foregroundStyle(.secondary).lineLimit(2)
+        }
+        .padding(12).frame(width: 150, height: 74, alignment: .topLeading)
+        .background(.quaternary.opacity(0.5), in: RoundedRectangle(cornerRadius: 12, style: .continuous))
+        if supported {
+            RouteLink { RexModuleView(widget: entry.widget) } label: { content }
+                .buttonStyle(.plain).accessibilityIdentifier("rex.module." + entry.widget.id)
+        } else {
+            content.opacity(0.55).accessibilityIdentifier("rex.module." + entry.widget.id)
+        }
+    }
+
+    private func status(_ entry: RexModel.Entry) -> String {
+        if !entry.checked { return L10n.text("Checking…") }
+        if let problem = entry.problem { if case .encrypted = problem { return L10n.text("Encrypted, not supported yet") }; return L10n.text("Can't open") }
+        return entry.widget.version.isEmpty ? L10n.text("Ready") : "v" + entry.widget.version
+    }
+
+    private var importSheet: some View {
+        NavigationStack {
+            Form {
+                Section { TextField("https://…/collection.rex", text: $address).textInputAutocapitalization(.never).autocorrectionDisabled().keyboardType(.URL)
+                } footer: { Text(L10n.text("Only list modules that are not encrypted run for now. The address is kept on this device.")) }
+                if !model.collections.isEmpty {
+                    Section {
+                        ForEach(model.collections) { item in
+                            Text(item.collection.title)
+                        }.onDelete { offsets in for index in offsets { model.remove(model.collections[index].address) } }
+                    }
+                }
+            }
+            .navigationTitle(L10n.text("Import Rex Subscription")).navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .cancellationAction) { Button(L10n.text("Done")) { importing = false } }
+                ToolbarItem(placement: .confirmationAction) {
+                    Button(L10n.text("Import")) { let value = address; address = ""; importing = false; Task { await model.add(value) } }
+                        .disabled(address.trimmingCharacters(in: .whitespaces).isEmpty)
+                }
+            }
+        }
+    }
+}
+
+/// One module's lists: a tab per list function, its options, and the titles it returns.
+struct RexModuleView: View {
+    let widget: RexCollection.Widget
+    @State private var module: RexModule?
+    @State private var selected: RexFunction?
+    @State private var choices: [String: String] = [:]
+    @State private var items: [RexItem] = []
+    @State private var page = 1
+    @State private var loading = false
+    @State private var more = true
+    @State private var failure: String?
+
+    var body: some View {
+        ScrollView {
+            VStack(alignment: .leading, spacing: 14) {
+                if let module {
+                    let lists = module.functions.filter(\.listsTitles)
+                    ScrollView(.horizontal, showsIndicators: false) {
+                        HStack { ForEach(lists) { function in
+                            Button(function.title) { select(function) }
+                                .buttonStyle(.bordered).tint(function.id == selected?.id ? .accentColor : .secondary)
+                                .accessibilityIdentifier("rex.function." + function.id)
+                        } }
+                    }
+                    if let selected {
+                        ForEach(selected.params.filter { $0.type == "enumeration" && !$0.options.isEmpty }, id: \.name) { param in
+                            Picker(param.title, selection: Binding(get: { choices[param.name] ?? param.value }, set: { choices[param.name] = $0; reload() })) {
+                                ForEach(param.options, id: \.value) { Text($0.title).tag($0.value) }
+                            }.pickerStyle(.menu)
+                        }
+                    }
+                }
+                LazyVGrid(columns: [GridItem(.adaptive(minimum: 104), spacing: 12, alignment: .top)], spacing: 14) {
+                    ForEach(items) { item in
+                        RouteLink { RexItemView(item: item) } label: { RexTile(item: item) }
+                            .buttonStyle(.plain).accessibilityIdentifier("rex.item." + item.id)
+                    }
+                }
+                if loading { ProgressView().frame(maxWidth: .infinity).accessibilityIdentifier("rex.loading") }
+                if let failure { Text(failure).font(.footnote).foregroundStyle(.secondary) }
+                if more, !items.isEmpty, !loading {
+                    Button(L10n.text("Load More")) { Task { await fetch(next: true) } }.frame(maxWidth: .infinity)
+                }
+            }.padding()
+        }
+        .navigationTitle(module?.title ?? widget.title)
+        .task {
+            do {
+                let loaded = try await RexRuntime.shared.module(widget)
+                module = loaded
+                if let first = loaded.functions.first(where: \.listsTitles) { select(first) }
+            } catch { failure = (error as? LocalizedError)?.errorDescription ?? error.localizedDescription }
+        }
+    }
+
+    private func select(_ function: RexFunction) { selected = function; choices = [:]; reload() }
+    private func reload() { items = []; page = 1; more = true; failure = nil; Task { await fetch(next: false) } }
+
+    private func fetch(next: Bool) async {
+        guard let function = selected, !loading else { return }
+        loading = true; defer { loading = false }
+        let wanted = next ? page + 1 : 1
+        do {
+            let more = try await RexRuntime.shared.items(widget, function: function, overrides: choices, page: wanted)
+            guard selected?.id == function.id else { return }
+            let known = Set(items.map(\.id))
+            let fresh = more.filter { !known.contains($0.id) }
+            self.more = !fresh.isEmpty && function.params.contains { $0.type == "page" }
+            items += fresh; page = wanted
+            if items.isEmpty { failure = L10n.text("This list is empty.") }
+        } catch { failure = (error as? LocalizedError)?.errorDescription ?? error.localizedDescription }
+    }
+}
+
+private struct RexTile: View {
+    let item: RexItem
+    var body: some View {
+        VStack(alignment: .leading, spacing: 4) {
+            Color.clear.aspectRatio(2.0 / 3, contentMode: .fit)
+                .overlay { PosterImage(url: item.poster) }
+                .clipShape(RoundedRectangle(cornerRadius: 10, style: .continuous))
+            Text(item.title).font(.caption.weight(.medium)).lineLimit(1)
+            Text(item.subtitle.isEmpty ? " " : item.subtitle).font(.caption2).foregroundStyle(.secondary).lineLimit(1)
+        }
+    }
+}
+
+/// A title from a Rex module: its cover and facts, and a way to search the user's own sources for it.
+struct RexItemView: View {
+    let item: RexItem
+    var body: some View {
+        ScrollView {
+            VStack(spacing: 16) {
+                PosterImage(url: item.poster).frame(width: 220, height: 330).clipShape(RoundedRectangle(cornerRadius: 14, style: .continuous))
+                Text(item.title).font(.title2.weight(.semibold)).multilineTextAlignment(.center)
+                if !item.subtitle.isEmpty { Text(item.subtitle).font(.subheadline).opacity(0.7) }
+                if !item.overview.isEmpty { Text(item.overview).font(.footnote).opacity(0.7).multilineTextAlignment(.leading) }
+                DiscoverFindSourcesButton(title: item.title).padding(.top, 8).accessibilityIdentifier("rex.findSources")
+            }.padding(40).frame(maxWidth: .infinity)
+        }
+        .background { DiscoverCanvas(poster: item.poster) }
+        .foregroundStyle(.white).preferredColorScheme(.dark)
+    }
+}
+#endif
diff --git a/Sources/TVCore/Rex.swift b/Sources/TVCore/Rex.swift
new file mode 100644
index 00000000..12470e40
--- /dev/null
+++ b/Sources/TVCore/Rex.swift
@@ -0,0 +1,209 @@
+import Foundation
+import CryptoKit
+
+/// Rex / ForwardWidgets modules: a `.rex` collection lists modules, each a plain JavaScript file that sets
+/// `WidgetMetadata` and names the functions that return lists of titles. This runs the plain ones on QuickJS with a
+/// small host (`assets://rex/prelude.js`); encrypted modules (`REXENC`) are recognised and reported, not run.
+public struct RexCollection: Codable, Hashable, Sendable {
+    public struct Widget: Codable, Hashable, Sendable, Identifiable {
+        public var id: String
+        public var title: String
+        public var version: String
+        public var author: String
+        public var url: String
+        public init(id: String, title: String, version: String = "", author: String = "", url: String) {
+            self.id = id; self.title = title; self.version = version; self.author = author; self.url = url
+        }
+    }
+    public var title: String
+    public var widgets: [Widget]
+
+    /// Reads a collection tolerantly: a module without a title or an address is skipped.
+    public static func parse(_ data: Data) throws -> RexCollection {
+        guard let root = try? JSONDecoder().decode(JSONValue.self, from: data).object, let list = root["widgets"]?.array else {
+            throw RexError.failed(L10n.text("This is not a Rex subscription."))
+        }
+        let widgets: [Widget] = list.compactMap { value in
+            guard let object = value.object, let url = object["url"]?.string, !url.isEmpty else { return nil }
+            let title = object["title"]?.string ?? object["id"]?.string ?? url
+            return Widget(id: object["id"]?.string ?? url, title: title, version: object["version"]?.string ?? "", author: object["author"]?.string ?? "", url: url)
+        }
+        return RexCollection(title: root["title"]?.string ?? "Rex", widgets: widgets)
+    }
+}
+
+public enum RexError: Error, LocalizedError, Sendable {
+    case encrypted
+    case failed(String)
+    public var errorDescription: String? {
+        switch self {
+        case .encrypted: L10n.text("Encrypted Rex modules are not supported yet.")
+        case .failed(let message): message
+        }
+    }
+}
+
+public struct RexParam: Hashable, Sendable {
+    public struct Option: Hashable, Sendable { public let title: String; public let value: String }
+    public let name: String
+    public let title: String
+    public let type: String
+    public let value: String
+    public let options: [Option]
+}
+
+public struct RexFunction: Hashable, Sendable, Identifiable {
+    public let id: String
+    public let title: String
+    public let functionName: String
+    public let params: [RexParam]
+    /// A "stream" module resolves a play address rather than listing titles.
+    public let listsTitles: Bool
+}
+
+public struct RexModule: Hashable, Sendable {
+    public let widget: RexCollection.Widget
+    public let title: String
+    public let functions: [RexFunction]
+    public let globals: [String: String]
+}
+
+public struct RexItem: Hashable, Sendable, Identifiable {
+    public let id: String
+    public let title: String
+    public let subtitle: String
+    public let poster: URL?
+    public let overview: String
+    public let rating: Double?
+    public let year: Int?
+}
+
+public actor RexRuntime {
+    public static let shared = RexRuntime()
+    private struct Loaded { let session: ScriptSession; let module: RexModule }
+    private var loaded: [String: Loaded] = [:]
+    private var recent: [String] = []
+    private static let maximumSessions = 6
+
+    /// The module's source, or `.encrypted` for the Rex-encrypted kind.
+    static func source(_ address: String) async throws -> String {
+        if address.hasPrefix("assets://") {
+            guard let text = ScriptAssets.bundled(address) else { throw RexError.failed("Missing bundled module") }
+            return text
+        }
+        guard let url = URL(string: address), ["http", "https"].contains(url.scheme?.lowercased() ?? "") else { throw RexError.failed(L10n.text("This is not a web address.")) }
+        var request = URLRequest(url: url, timeoutInterval: 20)
+        request.setValue("Mozilla/5.0", forHTTPHeaderField: "User-Agent")
+        let (data, response) = try await URLSession.shared.data(for: request)
+        if let code = (response as? HTTPURLResponse)?.statusCode, !(200..<300).contains(code) { throw RexError.failed("HTTP \(code)") }
+        let text = String(decoding: data, as: UTF8.self)
+        if text.hasPrefix("REXENC") { throw RexError.encrypted }
+        return text
+    }
+
+    public static func fetchCollection(_ address: String) async throws -> RexCollection {
+        if address.hasPrefix("assets://") {
+            guard let text = ScriptAssets.bundled(address) else { throw RexError.failed("Missing bundled collection") }
+            return try RexCollection.parse(Data(text.utf8))
+        }
+        guard let url = URL(string: address), ["http", "https"].contains(url.scheme?.lowercased() ?? "") else { throw RexError.failed(L10n.text("This is not a web address.")) }
+        var request = URLRequest(url: url, timeoutInterval: 20)
+        request.setValue("Mozilla/5.0", forHTTPHeaderField: "User-Agent")
+        let (data, _) = try await URLSession.shared.data(for: request)
+        return try RexCollection.parse(data)
+    }
+
+    /// Loads one module (reusing its runtime) and reads its metadata.
+    public func module(_ widget: RexCollection.Widget) async throws -> RexModule {
+        try await load(widget).module
+    }
+
+    /// Whether a module can be opened, without keeping it: nil when it can, else why not.
+    public func probe(_ widget: RexCollection.Widget) async -> RexError? {
+        do { _ = try await load(widget); return nil } catch let error as RexError { return error } catch { return .failed(error.localizedDescription) }
+    }
+
+    /// One function's titles. `params` start from the function's defaults; `overrides` replace them.
+    public func items(_ widget: RexCollection.Widget, function: RexFunction, overrides: [String: String], page: Int) async throws -> [RexItem] {
+        let entry = try await load(widget)
+        var params = entry.module.globals
+        for param in function.params where !param.value.isEmpty { params[param.name] = param.value }
+        for (key, value) in overrides { params[key] = value }
+        if function.params.contains(where: { $0.type == "page" }) { params["page"] = String(page) }
+        let json = String(decoding: try JSONSerialization.data(withJSONObject: params), as: UTF8.self)
+        let literal = String(decoding: try JSONSerialization.data(withJSONObject: [function.functionName], options: []), as: UTF8.self).dropFirst().dropLast()
+        let envelope = await entry.session.evaluate("__rex.call(\(literal), \(json))", within: 40)
+        guard let value = envelope["value"]?.object else {
+            throw RexError.failed(String((envelope["error"]?.string ?? "The module did not answer").prefix(200)))
+        }
+        if let message = value["error"]?.string { throw RexError.failed(message) }
+        return (value["items"]?.array ?? []).compactMap(Self.item)
+    }
+
+    private func load(_ widget: RexCollection.Widget) async throws -> Loaded {
+        if let existing = loaded[widget.url] {
+            recent.removeAll { $0 == widget.url }; recent.append(widget.url)
+            return existing
+        }
+        let source = try await Self.source(widget.url)
+        let profile = ScriptAssets.profiles.appendingPathComponent("rex-" + PluginChecksum.sha256(Data(widget.url.utf8)).prefix(16), isDirectory: true)
+        let session = try await ScriptSession.start(module: "assets://rex/prelude.js", supplied: ["rex://module": source], profile: profile, label: "rex " + widget.title)
+        let envelope = await session.evaluate("__rex.load()", within: 15)
+        guard let meta = envelope["value"]?.object else {
+            session.close()
+            throw RexError.failed(String((envelope["error"]?.string ?? "The module could not be read").prefix(200)))
+        }
+        let entry = Loaded(session: session, module: Self.module(widget, meta))
+        loaded[widget.url] = entry
+        recent.append(widget.url)
+        while recent.count > Self.maximumSessions {
+            let evicted = recent.removeFirst()
+            loaded.removeValue(forKey: evicted)?.session.close()
+        }
+        return entry
+    }
+
+    static func module(_ widget: RexCollection.Widget, _ meta: [String: JSONValue]) -> RexModule {
+        func params(_ list: [JSONValue]?) -> [RexParam] {
+            (list ?? []).compactMap { value in
+                guard let object = value.object, let name = object["name"]?.string else { return nil }
+                let options = (object["enumOptions"]?.array ?? []).compactMap { option -> RexParam.Option? in
+                    guard let o = option.object, let value = o["value"]?.string else { return nil }
+                    return RexParam.Option(title: o["title"]?.string ?? value, value: value)
+                }
+                return RexParam(name: name, title: object["title"]?.string ?? name, type: object["type"]?.string ?? "input",
+                                value: object["value"]?.string ?? "", options: options)
+            }
+        }
+        var globals: [String: String] = [:]
+        for param in params(meta["globalParams"]?.array) where !param.value.isEmpty { globals[param.name] = param.value }
+        let functions: [RexFunction] = (meta["modules"]?.array ?? []).compactMap { value in
+            guard let object = value.object, let name = object["functionName"]?.string else { return nil }
+            let type = object["type"]?.string ?? ""
+            return RexFunction(id: object["id"]?.string ?? name, title: object["title"]?.string ?? name, functionName: name,
+                               params: params(object["params"]?.array), listsTitles: type.isEmpty || type == "list")
+        }
+        return RexModule(widget: widget, title: meta["title"]?.string ?? widget.title, functions: functions, globals: globals)
+    }
+
+    static func item(_ value: JSONValue) -> RexItem? {
+        guard let object = value.object, let title = object["title"]?.string, !title.isEmpty else { return nil }
+        let date = object["releaseDate"]?.string ?? ""
+        var poster = object["posterPath"]?.string ?? ""
+        if poster.isEmpty { poster = object["backdropPath"]?.string ?? "" }
+        var rating: Double?
+        if case .number(let score)? = object["rating"], score > 0 { rating = score }
+        return RexItem(id: object["id"]?.string ?? title, title: title, subtitle: object["subtitle"]?.string ?? object["genreTitle"]?.string ?? "",
+                       poster: poster.isEmpty ? nil : URL(string: poster.replacingOccurrences(of: "http://", with: "https://")),
+                       overview: object["description"]?.string ?? "", rating: rating, year: Int(date.prefix(4)))
+    }
+}
+
+/// The collections a person imported (their addresses), kept on this device.
+public enum RexStore {
+    private static let key = "rex.collections"
+    public static var addresses: [String] {
+        get { UserDefaults.standard.stringArray(forKey: key) ?? [] }
+        set { UserDefaults.standard.set(newValue, forKey: key) }
+    }
+}
