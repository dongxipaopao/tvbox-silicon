diff --git a/Scripts/build-apple-python.sh b/Scripts/build-apple-python.sh
index 0b4c6530..554977bc 100755
--- a/Scripts/build-apple-python.sh
+++ b/Scripts/build-apple-python.sh
@@ -97,6 +97,11 @@ cp -R Runtime/PythonHost/base "$DEST/PythonHost/"
 # that are never checked against the sources.
 "$HOST_PYTHON" -I -m compileall -q -j 0 --invalidation-mode unchecked-hash "$DEST/python/lib" "$DEST/PythonHost" >/dev/null
 
+# Package size: every stdlib module ships its source, so the precompiled cache (about 19MB) is
+# regenerable weight; CPython compiles on import instead. The bundle is read-only, so nothing can
+# be written back at runtime either way.
+find "$DEST" -type d -name '__pycache__' -prune -exec rm -rf {} +
+
 # Extension modules into frameworks: Frameworks/<module>.framework/<module>, and <module>.fwork naming
 # it (relative to the app) where the .so was. The .origin file points back for importlib.
 find "$DEST/python" "$DEST/PythonHost" -name '*.so' | sort | while read -r library; do
